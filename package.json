{
  "name": "fixit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "auth:dev": "tsx watch services/auth/src/server.ts",
    "auth:start": "tsx services/auth/src/server.ts",
    "test:auth": "node --import tsx --test services/auth/test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "audit:high": "npm audit --audit-level=high",
    "auth:bootstrap": "tsx services/auth/src/admin-cli.ts bootstrap",
    "auth:reset-admin": "tsx services/auth/src/admin-cli.ts reset-admin"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
