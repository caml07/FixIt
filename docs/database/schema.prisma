// Contract-first draft for PostgreSQL schemas auth + tickets (Prisma ORM v7 syntax).
// SQL migration is reviewed separately; PostgreSQL CHECK/expression indexes live in SQL.
// One migration owner. Prisma CLI 7.3.0 validated schema syntax; SQL migration separately smoke-tested in ephemeral PostgreSQL 17. Drift not verified.
generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "tickets"]
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String
  displayName        String    @map("display_name")
  role               String
  accountStatus      String    @default("PENDING_PASSWORD_CHANGE") @map("account_status")
  passwordHash       String    @map("password_hash")
  temporaryExpiresAt DateTime? @map("temporary_expires_at") @db.Timestamptz(6)
  createdById        String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy          User?              @relation("UserCreators", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdUsers       User[]             @relation("UserCreators")
  sessions           Session[]
  subjectAudit       AccountAudit[]     @relation("AuditSubjects")
  actorAudit         AccountAudit[]     @relation("AuditActors")
  reportedTickets    SupportTicket[]    @relation("Reporters")
  assignedTickets    SupportTicket[]    @relation("Assignees")
  timelineEntries    TicketTimeline[]   @relation("TimelineActors")
  uploadedPhotos     TicketAttachment[] @relation("AttachmentUploaders")

  @@map("users")
  @@schema("auth")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  scope      String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId], map: "sessions_user_id_idx")
  @@map("sessions")
  @@schema("auth")
}

model AccountAudit {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectUserId String    @map("subject_user_id") @db.Uuid
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  action        String
  reason        String?
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  subject User  @relation("AuditSubjects", fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor   User? @relation("AuditActors", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([subjectUserId, occurredAt], map: "account_audit_subject_idx")
  @@map("account_audit")
  @@schema("auth")
}

model Category {
  code     String @id @db.VarChar(40)
  label    String @unique
  isActive Boolean @default(true) @map("is_active")

  tickets SupportTicket[]

  @@map("categories")
  @@schema("tickets")
}

model SupportTicket {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId   String    @map("reporter_id") @db.Uuid
  assigneeId   String?   @map("assignee_id") @db.Uuid
  categoryCode String    @map("category_code") @db.VarChar(40)
  title        String    @db.VarChar(160)
  description  String
  location     String?   @db.VarChar(160)
  equipment    String?   @db.VarChar(160)
  status       String    @default("OPEN")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  reporter   User              @relation("Reporters", fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignee   User?             @relation("Assignees", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  category   Category          @relation(fields: [categoryCode], references: [code], onDelete: Restrict, onUpdate: NoAction)
  timeline   TicketTimeline[]
  attachment TicketAttachment?

  @@index([reporterId, status], map: "support_tickets_reporter_status_idx")
  @@index([assigneeId, status], map: "support_tickets_assignee_status_idx")
  @@map("support_tickets")
  @@schema("tickets")
}

model TicketTimeline {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId      String   @map("ticket_id") @db.Uuid
  actorUserId   String   @map("actor_user_id") @db.Uuid
  eventType     String   @map("event_type")
  ticketVersion Int      @map("ticket_version")
  fromStatus    String?  @map("from_status")
  toStatus      String?  @map("to_status")
  reason        String?
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor  User          @relation("TimelineActors", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  outbox Outbox?       @relation("TimelineOutbox")

  @@unique([ticketId, ticketVersion], map: "ticket_timeline_version_uq")
  @@map("ticket_timeline")
  @@schema("tickets")
}

model Outbox {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId         String    @map("ticket_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  eventType        String    @map("event_type")
  payload          Json      @db.JsonB
  occurredAt       DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  attempts         Int       @default(0)

  timeline TicketTimeline @relation("TimelineOutbox", fields: [ticketId, aggregateVersion], references: [ticketId, ticketVersion], onDelete: Restrict, onUpdate: NoAction, map: "outbox_timeline_fk")

  @@unique([ticketId, aggregateVersion], map: "outbox_event_version_uq")
  @@map("outbox")
  @@schema("tickets")
}

model TicketAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    String   @unique @map("ticket_id") @db.Uuid
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  storageKey  String   @unique @map("storage_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  sha256Hex   String   @map("sha256_hex") @db.Char(64)
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  uploader User          @relation("AttachmentUploaders", fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("ticket_attachments")
  @@schema("tickets")
}
