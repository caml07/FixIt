{
  "name": "@fixit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome check src scripts vite.config.ts vitest.config.ts",
    "format": "biome check --write src scripts vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
