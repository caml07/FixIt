{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "BILLABLE temporary NAT, IPv4 and optional Fargate smoke service. No production app, DB or broker.",
  "Parameters": {
    "FoundationStack": {
      "Type": "String",
      "Default": "fixit-foundation",
      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9-]*"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    },
    "SmokeImage": {
      "Type": "String",
      "Default": "public.ecr.aws/amazonlinux/amazonlinux:2023",
      "Description": "Smoke only; verify and pin digest for assessed release."
    }
  },
  "Resources": {
    "SessionEip": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "SessionNat": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "SessionEip",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStack}-PublicSubnetId"
          }
        },
        "ConnectivityType": "public"
      }
    },
    "AppDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStack}-AppRouteTableId"
          }
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "SessionNat"
        }
      }
    },
    "SmokeLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SmokeLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "SmokeLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "SmokeTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "512",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "smoke",
            "Image": {
              "Ref": "SmokeImage"
            },
            "Essential": true,
            "EntryPoint": [
              "/bin/sh",
              "-c"
            ],
            "Command": [
              "echo 'FixIt infrastructure smoke: task started'; while true; do sleep 60; done"
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "SmokeLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "smoke"
              }
            }
          }
        ]
      }
    },
    "SmokeService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": "AppDefaultRoute",
      "Properties": {
        "Cluster": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStack}-ClusterName"
          }
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "TaskDefinition": {
          "Ref": "SmokeTask"
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 0,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStack}-AppSubnetId"
                }
              }
            ],
            "SecurityGroups": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStack}-SmokeSecurityGroupId"
                }
              }
            ]
          }
        }
      }
    },
    "SmokeCpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Pilot smoke service CPU above 80 percent; no notification configured",
        "Namespace": "AWS/ECS",
        "MetricName": "CPUUtilization",
        "Dimensions": [
          {
            "Name": "ClusterName",
            "Value": {
              "Fn::ImportValue": {
                "Fn::Sub": "${FoundationStack}-ClusterName"
              }
            }
          },
          {
            "Name": "ServiceName",
            "Value": {
              "Fn::GetAtt": [
                "SmokeService",
                "Name"
              ]
            }
          }
        ],
        "Statistic": "Average",
        "Period": 60,
        "EvaluationPeriods": 5,
        "DatapointsToAlarm": 5,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing"
      }
    }
  },
  "Outputs": {
    "NatPublicIp": {
      "Value": {
        "Ref": "SessionEip"
      }
    },
    "SmokeServiceName": {
      "Value": {
        "Fn::GetAtt": [
          "SmokeService",
          "Name"
        ]
      }
    },
    "SmokeLogGroup": {
      "Value": {
        "Ref": "SmokeLogs"
      }
    },
    "CpuAlarmName": {
      "Value": {
        "Ref": "SmokeCpuAlarm"
      }
    }
  }
}
