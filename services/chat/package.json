{
  "name": "@fixit/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "lint": "biome check src local test scripts",
    "format": "biome check --write src local test scripts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "mock": "tsx local/main.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongoose": "9.12.3",
    "rate-limiter-flexible": "11.5.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
