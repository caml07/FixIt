{
  "name": "fixit-tickets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/server.js",
    "db:validate": "prisma validate --config prisma.config.ts"
  },
  "dependencies": { "express": "5.3.0", "pg": "8.23.1" },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  },
  "overrides": { "@prisma/config": { "effect": "3.22.5" } }
}
